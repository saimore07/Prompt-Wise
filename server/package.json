{
  "name": "optiprompt-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend API for PromptWise with Gemini integration",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "eval:golden": "tsx src/evaluation/run-eval.ts --golden",
    "eval:live": "tsx src/evaluation/run-eval.ts --live",
    "benchmark": "tsx tests/performance/benchmark.ts"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "js-tiktoken": "^1.0.21",
    "mongoose": "^8.10.1",
    "typescript": "^5.7.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
